  "fechaEntrada": "2026-12-01",
  "fechaSalida": "2026-12-03",
  "ocupantes": []
}

### ---------------- Reservas (crear y consultar) ----------------

### 37) Crear una reserva de 5 noches con 1 acompañante -> 201 Created + Location. El script guarda el código.
###     Valor esperado: (2 x 90.000 + 3 x 112.500) x 2 ocupantes = valorTotal 1035000, estado PENDIENTE, versión v1
POST http://localhost:8080/api/reservas
Content-Type: application/json

{
  "identificacionApartamento": "ATK-001",
  "fechaEntrada": "2026-12-13",
  "fechaSalida": "2026-12-18",
  "canalOrigen": "PORTAL",
  "conMascota": false,
  "titular": { "documento": "1000000001", "nombre": "Carlos Pérez", "fechaNacimiento": "1990-05-01" },
  "ocupantes": [
    { "documento": "1000000002", "nombre": "Ana Gómez", "fechaNacimiento": "1992-08-20" }
  ]
}

> {% client.global.set("codigoReserva", response.body.codigo); %}

### 38) Consultar la reserva creada -> 200 OK
GET http://localhost:8080/api/reservas/{{codigoReserva}}

### 39) Se solapa con la reserva de la prueba 37 -> 409 Conflict (RN-01)
POST http://localhost:8080/api/reservas
Content-Type: application/json

{
  "identificacionApartamento": "ATK-001",
  "fechaEntrada": "2026-12-15",
  "fechaSalida": "2026-12-17",
  "canalOrigen": "DIRECTO",
  "titular": { "documento": "1000000010", "nombre": "Otro Huésped", "fechaNacimiento": "1988-01-10" },
  "ocupantes": []
}

